// Schéma Prisma — DYNASTIE SHOP (Système de Gestion Commerciale V1)
// Couvre l'ensemble des entités du cahier des charges V1. Seuls les
// modules Boutiques / Utilisateurs / Paramètres / Journal d'activité
// ont une UI en Phase 1 ; les autres modèles sont posés dès maintenant
// pour éviter des migrations disruptives lors des phases suivantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Boutiques & Utilisateurs
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  RESPONSABLE_BOUTIQUE
  LOGISTIQUE
  CAISSIER
}

model Boutique {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  stocks         Stock[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  boutiqueId   String?
  boutique     Boutique? @relation(fields: [boutiqueId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activityLogs   ActivityLog[]
  sales          Sale[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
}

// ---------------------------------------------------------------------------
// Produits
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  sku           String    @unique
  barcode       String?   @unique
  description   String?
  photoUrl      String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  purchasePrice Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  promoPrice    Decimal?  @db.Decimal(12, 2)
  minStock      Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variants ProductVariant[]
}

// Une variante représente une combinaison taille/couleur/pointure vendable.
// Pour un produit sans déclinaison, une variante "par défaut" est créée.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String?
  color         String?
  sku           String?  @unique
  barcode       String?  @unique
  purchasePrice Decimal? @db.Decimal(12, 2)
  sellingPrice  Decimal? @db.Decimal(12, 2)
  promoPrice    Decimal? @db.Decimal(12, 2)
  minStock      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stocks             Stock[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@unique([productId, size, color])
}

// ---------------------------------------------------------------------------
// Stocks
// ---------------------------------------------------------------------------

model Stock {
  id         String         @id @default(cuid())
  boutiqueId String
  boutique   Boutique       @relation(fields: [boutiqueId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@unique([boutiqueId, variantId])
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
  INVENTAIRE
  TRANSFERT_SORTANT
  TRANSFERT_ENTRANT
  VENTE
  RECEPTION_ACHAT
}

model StockMovement {
  id         String            @id @default(cuid())
  boutiqueId String
  boutique   Boutique          @relation(fields: [boutiqueId], references: [id])
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id])
  type       StockMovementType
  // Delta appliqué au stock (positif pour une entrée, négatif pour une sortie)
  quantity   Int
  reason     String?
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  transferId String?
  transfer   StockTransfer?    @relation(fields: [transferId], references: [id])
  createdAt  DateTime          @default(now())
}

enum TransferStatus {
  EN_ATTENTE
  VALIDE
  ANNULE
}

model StockTransfer {
  id             String         @id @default(cuid())
  fromBoutiqueId String
  fromBoutique   Boutique       @relation("TransferFrom", fields: [fromBoutiqueId], references: [id])
  toBoutiqueId   String
  toBoutique     Boutique       @relation("TransferTo", fields: [toBoutiqueId], references: [id])
  status         TransferStatus @default(EN_ATTENTE)
  createdAt      DateTime       @default(now())

  movements StockMovement[]
}

// ---------------------------------------------------------------------------
// Fournisseurs & Achats
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  BROUILLON
  ENVOYEE
  RECUE_PARTIELLE
  RECUE_TOTALE
  ANNULEE
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  reference  String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  boutiqueId String
  boutique   Boutique            @relation(fields: [boutiqueId], references: [id])
  status     PurchaseOrderStatus @default(BROUILLON)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id])
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitCost         Decimal        @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// Clients & Ventes
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  createdAt DateTime @default(now())

  sales Sale[]
}

enum SaleStatus {
  VALIDEE
  ANNULEE
}

model Sale {
  id          String     @id @default(cuid())
  reference   String     @unique
  boutiqueId  String
  boutique    Boutique   @relation(fields: [boutiqueId], references: [id])
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  status      SaleStatus @default(VALIDEE)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  items    SaleItem[]
  payments Payment[]
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  discount  Decimal        @default(0) @db.Decimal(12, 2)
}

enum PaymentMethod {
  ESPECES
  ORANGE_MONEY
  WAVE
  CARTE
  VIREMENT
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Journal d'activité & Paramètres
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

// Ligne unique de configuration globale de l'application.
model Settings {
  id                String   @id @default(cuid())
  companyName       String   @default("DYNASTIE SHOP")
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  currency          String   @default("GNF")
  invoicePrefix     String   @default("FAC")
  invoiceNextNumber Int      @default(1)
  ticketPrefix      String   @default("TCK")
  ticketNextNumber  Int      @default(1)
  updatedAt         DateTime @updatedAt
}
