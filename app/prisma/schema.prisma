// Schéma Prisma — DYNASTIE SHOP (Système de Gestion Commerciale V1)
// Couvre l'ensemble des entités du cahier des charges V1. Seuls les
// modules Boutiques / Utilisateurs / Paramètres / Journal d'activité
// ont une UI en Phase 1 ; les autres modèles sont posés dès maintenant
// pour éviter des migrations disruptives lors des phases suivantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Boutiques & Utilisateurs
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  CAISSIER
  LOGISTIQUE
}

// Un même modèle pour les boutiques et l'entrepôt central : du point de vue
// des stocks, un entrepôt est un emplacement comme un autre, seul son
// `type` diffère. Évite de dupliquer toute la logique de stock/mouvements/
// transferts dans une deuxième table, et permet d'ajouter d'autres
// entrepôts plus tard sans migration.
enum BoutiqueType {
  BOUTIQUE
  ENTREPOT
}

model Boutique {
  id        String       @id @default(cuid())
  name      String
  type      BoutiqueType @default(BOUTIQUE)
  address   String?
  phone     String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  stocks            Stock[]
  stockMovements    StockMovement[]
  sales             Sale[]
  purchaseOrders    PurchaseOrder[]
  expenses          Expense[]
  transfersOut      StockTransfer[]    @relation("TransferFrom")
  transfersIn       StockTransfer[]    @relation("TransferTo")
  inventorySessions InventorySession[]
  fixedExpenses     FixedExpense[]
  restockRequests   RestockRequest[]
}

model User {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique
  passwordHash       String
  // Vrai pour un compte fraîchement créé (code par défaut "0000") ou dont
  // le Super Admin vient de réinitialiser le code — faux par défaut pour
  // ne jamais perturber un compte existant qui a déjà son propre code
  // (voir seed/comptes historiques). Contrôlé au niveau middleware.ts, qui
  // redirige vers /changer-mot-de-passe tant que c'est vrai.
  mustChangePassword Boolean   @default(false)
  role               Role
  // Accès supplémentaires au-delà de ceux accordés par le rôle (ex. un
  // Caissier qui doit aussi consulter Stocks) — vient s'ADDITIONNER aux
  // modules du rôle, ne les remplace jamais. Voir lib/permissions.ts.
  extraModules       String[]  @default([])
  active             Boolean   @default(true)
  boutiqueId         String?
  boutique           Boutique? @relation(fields: [boutiqueId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Protection anti brute-force : le code de connexion n'étant que 4
  // chiffres (10 000 combinaisons), on bloque temporairement le compte
  // après plusieurs échecs consécutifs plutôt que de compter uniquement
  // sur la lenteur de bcrypt.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  activityLogs            ActivityLog[]
  sales                   Sale[]
  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrdersCancelled PurchaseOrder[]    @relation("PurchaseOrderCancelledBy")
  transfersInitiated      StockTransfer[]    @relation("TransferInitiatedBy")
  transfersValidated      StockTransfer[]    @relation("TransferValidatedBy")
  transfersCancelled      StockTransfer[]    @relation("TransferCancelledBy")
  restockRequested        RestockRequest[]   @relation("RestockRequestedBy")
  restockResolved         RestockRequest[]   @relation("RestockRequestResolvedBy")
  saleEditRequested       SaleEditRequest[]  @relation("SaleEditRequestedBy")
  saleEditResolved        SaleEditRequest[]  @relation("SaleEditRequestResolvedBy")
  expenses                Expense[]
  saleReturns             SaleReturn[]
  inventorySessions       InventorySession[]
  payments                Payment[]
  supplierPayments        SupplierPayment[]
}

// ---------------------------------------------------------------------------
// Produits
// ---------------------------------------------------------------------------

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([categoryId, name])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  sku           String       @unique
  barcode       String?      @unique
  description   String?
  photoUrl      String?
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  variants ProductVariant[]
}

// Une variante représente une combinaison couleur/taille vendable — c'est
// elle qui porte le prix, le code-barres et le stock, jamais le produit
// générique. Pour un produit sans déclinaison, une variante "par défaut"
// (couleur/taille vides) est créée.
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color          String?
  size           String?
  sku            String?  @unique
  barcode        String?  @unique
  purchasePrice  Decimal  @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  alertThreshold Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stocks                Stock[]
  saleItems             SaleItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  stockMovements        StockMovement[]
  transferItems         StockTransferItem[]
  inventorySessionLines InventorySessionLine[]
  restockRequests       RestockRequest[]

  @@unique([productId, color, size])
}

// ---------------------------------------------------------------------------
// Stocks
// ---------------------------------------------------------------------------

model Stock {
  id         String         @id @default(cuid())
  boutiqueId String
  boutique   Boutique       @relation(fields: [boutiqueId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@unique([boutiqueId, variantId])
}

enum IdleTimeoutMode {
  LOCK
  LOGOUT
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
  INVENTAIRE
  TRANSFERT_SORTANT
  TRANSFERT_ENTRANT
  VENTE
  RETOUR_VENTE
  RECEPTION_ACHAT
}

model StockMovement {
  id         String            @id @default(cuid())
  boutiqueId String
  boutique   Boutique          @relation(fields: [boutiqueId], references: [id])
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id])
  type       StockMovementType
  // Delta appliqué au stock (positif pour une entrée, négatif pour une sortie)
  quantity   Int
  reason     String?
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  transferId String?
  transfer   StockTransfer?    @relation(fields: [transferId], references: [id])
  createdAt  DateTime          @default(now())
}

enum TransferStatus {
  EN_ATTENTE
  VALIDE
  ANNULE
}

model StockTransfer {
  id             String         @id @default(cuid())
  reference      String         @unique
  fromBoutiqueId String
  fromBoutique   Boutique       @relation("TransferFrom", fields: [fromBoutiqueId], references: [id])
  toBoutiqueId   String
  toBoutique     Boutique       @relation("TransferTo", fields: [toBoutiqueId], references: [id])
  status         TransferStatus @default(EN_ATTENTE)
  userId         String?
  user           User?          @relation("TransferInitiatedBy", fields: [userId], references: [id])
  createdAt      DateTime       @default(now())

  validatedAt       DateTime?
  validatedByUserId String?
  validatedBy       User?     @relation("TransferValidatedBy", fields: [validatedByUserId], references: [id])

  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?     @relation("TransferCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  items           StockTransferItem[]
  movements       StockMovement[]
  restockRequests RestockRequest[]
}

// Le contenu prévu du transfert (quel produit, quelle quantité), distinct
// des `StockMovement` qui ne sont créés qu'à la validation (voir section 8
// du document d'architecture : le stock ne bouge jamais avant confirmation
// de réception).
model StockTransferItem {
  id         String         @id @default(cuid())
  transferId String
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
}

enum RestockRequestStatus {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

// Un Caissier ne peut pas créer de transfert lui-même (module réservé à
// Logistique/Super Admin, voir lib/permissions.ts) — il peut seulement
// signaler qu'un produit manque dans sa boutique. Logistique/Super Admin
// décide ensuite, et crée le vrai StockTransfer manuellement via le flux
// habituel (pas de lien direct conservé ici, pour rester simple — la
// demande sert de ticket, pas d'automatisation).
model RestockRequest {
  id         String         @id @default(cuid())
  reference  String         @unique
  boutiqueId String
  boutique   Boutique       @relation(fields: [boutiqueId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int?
  note       String?

  status            RestockRequestStatus @default(EN_ATTENTE)
  requestedByUserId String?
  requestedBy       User?                @relation("RestockRequestedBy", fields: [requestedByUserId], references: [id])
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolvedBy        User?                @relation("RestockRequestResolvedBy", fields: [resolvedByUserId], references: [id])
  resolutionNote    String?
  // Transfert créé ET validé automatiquement au moment où la demande est
  // acceptée (voir resolveRestockRequest) — plus d'étape manuelle
  // intermédiaire, le stock bouge tout de suite.
  transferId        String?
  transfer          StockTransfer?       @relation(fields: [transferId], references: [id])
  createdAt         DateTime             @default(now())
}

enum SaleEditRequestStatus {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

// Contrôle anti-fraude (voir document d'architecture, §5) : un Caissier ne
// peut jamais corriger une vente lui-même — il peut seulement signaler
// l'erreur. `createReturn` (../ventes/actions.ts) est réservée au Super
// Admin ; cette demande est le ticket qui déclenche sa vérification avant
// qu'il n'utilise ce même mécanisme de retour pour corriger.
model SaleEditRequest {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])
  reason String

  status            SaleEditRequestStatus @default(EN_ATTENTE)
  requestedByUserId String?
  requestedBy       User?                 @relation("SaleEditRequestedBy", fields: [requestedByUserId], references: [id])
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolvedBy        User?                 @relation("SaleEditRequestResolvedBy", fields: [resolvedByUserId], references: [id])
  resolutionNote    String?
  createdAt         DateTime              @default(now())
}

// Une session d'inventaire conserve TOUTES les lignes comptées (même sans
// écart), contrairement aux `StockMovement` (type INVENTAIRE) qui ne tracent
// que les ajustements effectifs. Nécessaire pour l'historique et le reçu PDF,
// qui doivent montrer la photo complète du comptage, pas seulement les écarts.
model InventorySession {
  id          String   @id @default(cuid())
  reference   String   @unique
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  lineCount   Int
  changeCount Int
  createdAt   DateTime @default(now())

  lines InventorySessionLine[]
}

model InventorySessionLine {
  id                  String           @id @default(cuid())
  sessionId           String
  session             InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant   @relation(fields: [variantId], references: [id])
  theoreticalQuantity Int
  countedQuantity     Int
  delta               Int
}

// ---------------------------------------------------------------------------
// Fournisseurs & Achats
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  BROUILLON
  ENVOYEE
  RECUE_PARTIELLE
  RECUE_TOTALE
  ANNULEE
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  reference  String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  boutiqueId String
  boutique   Boutique            @relation(fields: [boutiqueId], references: [id])
  status     PurchaseOrderStatus @default(BROUILLON)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id])
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?     @relation("PurchaseOrderCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  items    PurchaseOrderItem[]
  payments SupplierPayment[]
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitCost         Decimal        @db.Decimal(12, 2)
}

// Symétrique de `Payment` (côté client/Crédits) mais pour ce qu'on doit à un
// fournisseur. Le montant dû n'est jamais stocké : toujours recalculé comme
// Σ(unitCost × quantityReceived) des lignes de la commande moins la somme de
// ces paiements — on ne doit de l'argent que sur la marchandise réellement
// reçue, pas sur ce qui est seulement commandé.
model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  createdAt       DateTime      @default(now())

  // Qui a enregistré ce paiement — même logique que Payment.userId côté
  // ventes/crédits. Nullable : les paiements créés avant ce champ n'ont
  // pas cette info.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Clients & Ventes
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  createdAt DateTime @default(now())

  sales Sale[]
}

enum SaleStatus {
  VALIDEE
  ANNULEE
}

model Sale {
  id          String     @id @default(cuid())
  reference   String     @unique
  boutiqueId  String
  boutique    Boutique   @relation(fields: [boutiqueId], references: [id])
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  status      SaleStatus @default(VALIDEE)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  // Frais de livraison facturés au client sur cette vente (pré-rempli à la
  // caisse avec Settings.defaultDeliveryFee, modifiable par vente) — inclus
  // dans totalAmount (voir ventes/actions.ts, createSale) puisque c'est
  // réellement encaissé, mais tracké à part pour le reporting ("combien la
  // livraison a généré"), sans jamais entrer dans le calcul de marge
  // (purement basé sur les lignes de vente, voir rapports/report-data.ts).
  deliveryFee Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @db.Decimal(12, 2)
  // Vente à un revendeur qui paie plus tard (en une fois ou par tranches) —
  // aucune échéance n'est imposée (voir module Crédits). Le solde dû se
  // calcule à la volée : totalAmount - somme(payments.amount). Les
  // remboursements ultérieurs sont de simples `Payment` supplémentaires
  // ajoutés après coup à cette même vente.
  isCredit    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  items        SaleItem[]
  payments     Payment[]
  returns      SaleReturn[]
  editRequests SaleEditRequest[]
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  discount  Decimal        @default(0) @db.Decimal(12, 2)

  returnItems SaleReturnItem[]
}

// Retour simple (V1) : remet la quantité en stock côté boutique et trace
// l'opération. Pas de gestion détaillée du remboursement (espèces/avoir)
// pour cette phase — décision validée avec le porteur du projet.
model SaleReturn {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  // Montant réellement dû au client pour ce retour (calculé serveur à
  // partir du prix net — remise incluse — des lignes retournées, jamais
  // fourni par le client). `refundMethod` est vide quand `asStoreCredit`
  // est vrai : rien n'est rendu tout de suite, c'est un avoir à valoir sur
  // un prochain achat (pas de registre de solde dédié pour l'instant — V1).
  refundAmount  Decimal        @default(0) @db.Decimal(12, 2)
  refundMethod  PaymentMethod?
  asStoreCredit Boolean        @default(false)

  items SaleReturnItem[]
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItemId   String
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  quantity     Int
}

enum PaymentMethod {
  ESPECES
  ORANGE_MONEY
  MTN_MONEY
  WAVE
  CARTE
  VIREMENT
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  // Qui a encaissé ce paiement précis (paiement initial à la vente, ou
  // remboursement de crédit ajouté après coup) — distinct de Sale.userId,
  // qui ne reflète que le vendeur de la vente d'origine. Nullable : les
  // paiements créés avant ce champ n'ont pas cette info.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Dépenses
// ---------------------------------------------------------------------------

// Module volontairement simple (V1) : pas de catégories de dépenses
// configurables, un champ texte libre suffit pour démarrer. Saisie
// réservée au Super Admin (décision validée avec le porteur du projet).
model Expense {
  id             String        @id @default(cuid())
  type           String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @default(now())
  boutiqueId     String?
  boutique       Boutique?     @relation(fields: [boutiqueId], references: [id])
  comment        String?
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  fixedExpenseId String?
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id])
  createdAt      DateTime      @default(now())
}

// Modèle paramétrable d'une dépense récurrente (loyer, salaires...) : pas
// de génération automatique mensuelle (trop risqué sans supervision — un
// montant qui varie un mois, un loyer qui saute) — juste un préréglage
// qu'on enregistre en un clic depuis /depenses, qui crée une Expense liée.
model FixedExpense {
  id         String    @id @default(cuid())
  label      String
  amount     Decimal   @db.Decimal(12, 2)
  boutiqueId String?
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id])
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  expenses Expense[]
}

// ---------------------------------------------------------------------------
// Journal d'activité & Paramètres
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

// Ligne unique de configuration globale de l'application.
model Settings {
  id                String  @id @default(cuid())
  companyName       String  @default("DYNASTIE SHOP")
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  currency          String  @default("GNF")
  invoicePrefix     String  @default("FAC")
  invoiceNextNumber Int     @default(1)
  ticketPrefix      String  @default("TCK")
  ticketNextNumber  Int     @default(1)

  // Seuil pré-rempli sur la fiche d'un nouveau produit (voir ProductForm) —
  // reste modifiable produit par produit, ce n'est qu'une valeur de départ.
  defaultAlertThreshold Int @default(5)

  // Protection anti brute-force (voir auth.ts) — réglable plutôt que fixé
  // dans le code, pour que le Super Admin puisse l'assouplir ou la durcir
  // sans intervention technique.
  maxFailedLoginAttempts Int @default(5)
  lockoutDurationMinutes Int @default(15)

  // Plafond de remise qu'un Caissier peut appliquer en Caisse sans passer
  // par le Super Admin — 100 par défaut (aucune restriction) pour ne
  // jamais changer le comportement existant tant que ce n'est pas réglé
  // explicitement. Le Super Admin n'est lui-même jamais plafonné (voir
  // ventes/actions.ts, createSale).
  maxDiscountPercent Int @default(100)

  // Méthodes de paiement proposées dans les formulaires de vente/crédit/
  // fournisseur (voir caisse-client.tsx, repayment-dialog.tsx,
  // payment-dialog.tsx) — toutes actives par défaut, pour ne jamais faire
  // disparaître une méthode déjà utilisée sans action explicite du Super
  // Admin.
  activePaymentMethods String[] @default(["ESPECES", "ORANGE_MONEY", "MTN_MONEY", "WAVE", "CARTE", "VIREMENT"])

  // Montant pré-rempli sur le champ livraison en Caisse, modifiable à
  // chaque vente — pas une grille de tarifs par zone/quartier : à Conakry
  // le prix dépend surtout du trajet négocié avec le livreur au moment de
  // la course, un tarif figé par zone serait corrigé à la main de toute
  // façon (voir discussion avec l'utilisateur).
  defaultDeliveryFee Int @default(0)

  // Déconnexion/verrouillage automatique après inactivité (0 = désactivé) —
  // scénario réel : un poste de caisse resté connecté sans surveillance
  // après une coupure de courant. Verrouillage (recode à 4 chiffres) par
  // défaut, moins perturbant qu'une déconnexion complète pour un caissier
  // qui s'absente quelques minutes entre deux clients ; LOGOUT reste
  // disponible pour qui préfère la sécurité maximale. S'applique à tous les
  // comptes de la même façon (Super Admin compris), un seul réglage global.
  idleTimeoutMinutes Int             @default(10)
  idleTimeoutMode    IdleTimeoutMode @default(LOCK)

  updatedAt DateTime @updatedAt
}
